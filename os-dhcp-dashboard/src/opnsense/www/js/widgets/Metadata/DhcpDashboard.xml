<!--
    os-dhcp-dashboard - widget metadata
    Version: 1.0.0

    No endpoint is listed on purpose: the widget combines several optional
    backends (ISC plugin, Kea, Dnsmasq). Listing them would hide the widget
    for any user missing one of them. Each backend call is handled by the
    widget itself and silently skipped when unavailable.
-->
<metadata>
    <dhcpdashboard>
        <filename>DhcpDashboard.js</filename>
        <endpoints>
            <independent/>
        </endpoints>
        <translations>
            <title>DHCP Leases</title>
            <ipaddress>IP address</ipaddress>
            <hostname>Hostname</hostname>
            <mac>MAC address</mac>
            <interface>Interface</interface>
            <leasetype>Lease type</leasetype>
            <source>Server</source>
            <status>Status</status>
            <dynamic>dynamic</dynamic>
            <static>static</static>
            <online>Online</online>
            <offline>Offline</offline>
            <unknown>Unknown</unknown>
            <nobackend>No running DHCP server found (ISC, Kea or Dnsmasq).</nobackend>
            <noleases>No active leases found.</noleases>
            <showipv6>Show IPv6 leases</showipv6>
            <yes>Yes</yes>
            <no>No</no>
        </translations>
    </dhcpdashboard>
</metadata>
